    private async Task OnControllerChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? "PDG";
        State.SetControllerByKey(key, loadDefaultGains: true);
        await OnStateChanged.InvokeAsync();
    }

    private async Task OnResetGainsClicked()
    {
        State.ApplyDefaultGains();
        await NotifyChanged();
    }

    private async Task OnCtModeChanged(ChangeEventArgs e)
    {
        State.PredictHalfSample = e.Value?.ToString() != "textbook";
        await NotifyChanged();
    }

    private async Task OnGainChanged(int kind, int index, ChangeEventArgs e)
    {
        var val = LabFormat.TryParseInvariant(e.Value?.ToString(), out var v) ? v : double.NaN;
        if (kind == 0) State.Kp[index] = val;
        else if (kind == 1) State.Kd[index] = val;
        else State.Ki[index] = val;
        await NotifyChanged();
    }

