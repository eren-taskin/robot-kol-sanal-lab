        await NotifyChanged();
    }

    private async Task OnStepMsChanged(ChangeEventArgs e)
    {
        if (LabFormat.TryParseInvariant(e.Value?.ToString(), out var ms))
        {
            State.StepSeconds = ms / 1000.0;
            // If Duration had fractional step alignment (e.g. from scenario #8), snap Duration to an integer multiple of the new Step when Step > 0.
            if (State.StepSeconds > 0 && double.IsFinite(State.DurationSeconds))
            {
                var rounded = Math.Round(State.DurationSeconds);
                if (Math.Abs(State.DurationSeconds - rounded) > 1e-6)
                {
                    State.DurationSeconds = rounded;
                }
            }
        }
        else
        {
            State.StepSeconds = double.NaN;
        }
        await NotifyChanged();
    }

