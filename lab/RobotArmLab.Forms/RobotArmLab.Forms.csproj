<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Forms laboratuvarı. Mac'te de derlenebilsin diye EnableWindowsTargeting açıktır; çalıştırmak Windows ister. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 sürümü: ScottPlot.WinForms'un kullandığı SkiaSharp.Views.WindowsForms yalnız bu hedef için .NET sürümü taşır. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- HelixToolkit.Wpf bir WPF kütüphanesidir; ElementHost ile forma gömülür. -->
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RobotArmLab.Forms</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RobotArmLab.Core\RobotArmLab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

</Project>
